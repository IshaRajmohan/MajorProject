# Copy to .env and fill in your key (optional — demo works with rule-based fallback)
GEMINI_API_KEY=
# Optional model override
GEMINI_MODEL=gemini-2.5-flash

# --- PostgreSQL (required for runtime — no JSON fallback) ---
# Create once, e.g.:  CREATE DATABASE nyayaos_rbac;
DATABASE_URL=postgresql+asyncpg://nyayaos:your_password@localhost:5432/nyayaos_rbac

# --- Auth (JWT access tokens) ---
# Required to mint/verify tokens for POST /auth/login and GET /auth/me
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Access token lifetime in minutes (default 60)
JWT_EXPIRE_MINUTES=60

# --- Development seed users (idempotent on API startup) ---
# Shared password for ALL seeded accounts. Development only — never use in production.
DEV_SEED_PASSWORD=NyayaOS-dev-2026!
# Seeded emails / system roles:
#   admin@nyayaos.dev      ADMIN
#   court@nyayaos.dev      COURT
#   police@nyayaos.dev     POLICE
#   lawyer@nyayaos.dev     LAWYER
#   forensic@nyayaos.dev   FORENSIC
#   citizen@nyayaos.dev    CITIZEN
